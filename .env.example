# PatchPilot backend config. Copy to `.env` (gitignored) and fill in. Full list, owners and sources: docs/CONFIG.md
# NEVER put real secrets in this file or in git.

# --- AI (T04). Provider and key are announced at kickoff ---
LLM_PROVIDER=anthropic            # anthropic | openai
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=                     # optional: gateway / Azure URL
LLM_MODE=mock                     # mock | live

# --- Boomi (T10). Values come from the Boomi team ---
BOOMI_MODE=mock                   # mock | live
BOOMI_BASE_URL=                   # https://c01-sg.integrate.boomi.com (our Atom Cloud)
BOOMI_USER=                       # Shared Web Server user
BOOMI_TOKEN=                      # Shared Web Server token
# This Atom tier serves only /ws/simple/... paths (see boomi/README.md)
BOOMI_B2_PATH=/ws/simple/createPatchpilotfinding
BOOMI_B3_PATH=/ws/simple/createPatchpilotscansummary
BOOMI_B4_PATH=/ws/simple/getPatchpilotcompliance

# --- Git hosts (T09) ---
GITHUB_MODE=mock                  # mock | live
GITHUB_TOKEN=
GITLAB_TOKEN=                     # optional, stretch

# --- Scanning ---
DEMO_REPO_URL=https://github.com/BommepalliRoop/demo-target
ALLOWED_REPO_PREFIXES=https://github.com/BommepalliRoop/    # comma-separated
WORK_DIR=                         # blank = <system temp>/patchpilot
THREAT_INTEL=live                 # live | mock | off
SCAN_TIMEOUT_S=600
MAX_SCANS_PER_HOUR=20
FIX_PYTHON=                       # interpreter for fix venvs; blank = backend Python. Demo target needs 3.11
FIX_CONCURRENCY=4                 # package fixes in parallel; use 1 on 512 MB hosts (Render free)

# --- Service ---
DEMO_MODE=false                   # true on demo day: enables POST /api/demo/reset (still needs the API key)
PATCHPILOT_API_KEY=               # python -c "import secrets;print(secrets.token_urlsafe(32))"
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
